    },
    "%@ doesn't load on %@: the dev server only listens on localhost. Restart it on the same port listening on the network (0.0.0.0) so I can open it through %@ over the tailnet. Don't open a tunnel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法在 %@ 上加载：开发服务器仅监听 localhost。请在相同端口上将监听地址改为 0.0.0.0 后重启，以便我通过 Tailnet 从 %@ 打开。不要建立隧道。"
          }
        }
      }
    },
