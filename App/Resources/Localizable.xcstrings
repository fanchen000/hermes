  "strings": {
    "%@ only works on this machine. Give the gateway an address your iPhone can reach, such as its Tailscale name or network address, then pair.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能在这台设备上使用。请为网关设置 iPhone 可以访问的地址，例如 Tailscale 设备名或局域网地址，然后重新配对。"
          }
        }
      }
    },
