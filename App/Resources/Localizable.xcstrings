        }
      }
    },
    "The gateway didn't take the key. Check that Bot Mode is connected and try again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关未接受此密钥。请确认智能体模式已连接，然后重试。"
          }
        }
      }
    },
    "The gateway doesn't allow viewing its screen from here.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关不允许从此处查看其屏幕。"
          }
        }
      }
    },
    "The gateway has no wake word engine, or no voice to answer with.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关没有唤醒词引擎，或没有可用于回复的语音。"
