    },
    "It still needs": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然需要"
          }
        }
      }
    },
    "It stops on %@. Hermes hears it was stopped.": {
      "extractionState": "manual",
