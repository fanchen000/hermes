    "%@ asks in the chat before it changes memory. Changes made while nobody can answer (tasks, background reviews) wait here for review.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会在修改记忆前先在对话中征求同意。无人能答复时（如定时任务或后台审核）产生的变更会留在这里等待审核。"
          }
        }
      }
    },
