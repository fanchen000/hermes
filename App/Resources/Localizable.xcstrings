    },
    "It runs at full priority until then.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前以最高优先级运行。"
          }
        }
      }
    },
    "It runs on %@, not on %@.": {
      "extractionState": "manual",
      "localizations": {
