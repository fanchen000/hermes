    },
    "The gateway listens for one device at a time: this %@ takes over when that one stops.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关每次只监听一台设备；原设备停止后，此 %@ 会接管。"
          }
        }
      }
    },
    "The gateway runs them on schedule.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关按计划运行它们。"
