          }
        }
      }
    },
    "The app installs and manages plugins through Hermes’s backend (hermes serve). Link Bot Mode for %@ to see what’s installed and add more.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用通过 Hermes 后端（hermes serve）安装和管理插件。请为 %@ 关联智能体模式，以查看已安装插件并添加更多插件。"
