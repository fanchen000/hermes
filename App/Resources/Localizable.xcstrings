    },
    "Hermes is waiting for your answer.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 正在等待你的回答。"
          }
        }
      }
    },
    "Hermes is writing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 正在写入"
          }
        }
      }
    },
    "Hermes is writing…": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 正在写入…"
          }
        }
      }
    },
    "Hermes isn’t waiting on you in any chat.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有对话在等待你处理。"
          }
        }
      }
    },
    "Hermes keeps the goal across turns until you clear it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你清除目标之前，Hermes 会跨轮次保留它。"
          }
        }
      }
    },
    "Hermes keeps this summary in place of the earlier messages. It can't be edited.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 使用此摘要替代较早的消息，此摘要不可编辑。"
          }
        }
      }
    },
    "Hermes keeps waiting for the page while the app reconnects.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用重新连接期间，Hermes 会继续等待页面。"
          }
        }
      }
    },
    "Hermes keeps working after you leave the app. Notifications bring you back when it matters.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你离开应用后 Hermes 仍会继续工作，重要事项会通过通知提醒你。"
          }
        }
      }
    },
    "Hermes leaves out the tools of a toolset that needs a key until it has one.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在配置所需密钥之前，Hermes 不会提供该工具集中的工具。"
          }
        }
      }
    },
    "Hermes lets only a signed-in app drive its browser, and Bot Mode on %@ signs in automatically.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 只允许已登录的应用控制浏览器，而 %@ 上的智能体模式会自动登录。"
          }
        }
      }
    },
    "Hermes loses its %@ tools on %@. Your %@ account stays as it is.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将失去 %@ 上的 %@ 工具，但你的 %@ 账户保持不变。"
          }
        }
      }
    },
    "Hermes loses its tools on %@. Open chats reload theirs.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将失去 %@ 上的工具，已打开的对话会重新加载工具。"
          }
        }
      }
    },
    "Hermes moves its workspace; a running turn follows.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将移动工作区，正在运行的轮次会一并迁移。"
          }
        }
      }
    },
    "Hermes needs a model": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 需要配置模型"
          }
        }
      }
    },
    "Hermes needs a password": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 需要密码"
          }
        }
      }
    },
    "Hermes needs you": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 需要你处理"
          }
        }
      }
    },
    "Hermes needs your OK": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 需要你的批准"
          }
        }
      }
    },
    "Hermes never opens a blocked site, and always refuses addresses that would expose a key or a cloud server's metadata.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 不会打开已屏蔽的网站，也会拒绝可能泄露密钥或云服务器元数据的地址。"
          }
        }
      }
    },
    "Hermes never saw the number": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 未看到该号码"
          }
        }
      }
    },
    "Hermes never sees a password. The gateway fills it into the site it belongs to, and only there.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 不会读取密码；网关只会在该密码所属的网站填写它。"
          }
        }
      }
    },
    "Hermes no longer has this reply.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 已不再保留此回复。"
          }
        }
      }
    },
    "Hermes on %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Hermes"
          }
        }
      }
    },
    "Hermes on %@ can say how its Mac runs it once the Hermes app plugin is installed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Hermes 应用插件后，%@ 上的 Hermes 才能报告 Mac 上的运行方式。"
          }
        }
      }
    },
    "Hermes on %@ clones it and installs it with the access its manifest asks for. Plugins from outside the catalog aren't scanned.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Hermes 会克隆并按清单要求的权限安装它。目录外插件不会经过扫描。"
          }
        }
      }
    },
    "Hermes on %@ didn't say how its Mac runs it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Hermes 未说明其 Mac 如何运行该操作。"
          }
        }
      }
    },
    "Hermes on %@ has no key for these. Or add one there with `hermes model`.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Hermes 没有所需密钥，可以在该设备上通过 hermes model 添加。"
          }
        }
      }
    },
    "Hermes on %@ has no model provider, so chats get no answers.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Hermes 未配置模型提供商，因此对话不会得到回答。"
          }
        }
      }
    },
    "Hermes on %@ has no model provider, so it can't answer.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 Hermes 未配置模型提供商，因此无法回答。"
          }
        }
      }
    },
    "Hermes puts these files back as they were at %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将文件恢复到 %@ 时的状态"
          }
        }
      }
    },
    "Hermes reaches you while the app is open.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用打开期间，Hermes 可以联系你。"
          }
        }
      }
    },
    "Hermes reads it after the current step and keeps going.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 完成当前步骤后读取，并继续执行。"
          }
        }
      }
    },
    "Hermes reads it after the next tool call.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将在下一次工具调用后读取它。"
          }
        }
      }
    },
    "Hermes reads this at the start of every chat, so changes apply from your next one.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在每段对话开始时读取此项，因此更改从下一段对话起生效。"
          }
        }
      }
    },
    "Hermes remembers with its built-in memory until it is.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此之前，Hermes 会使用内置记忆记住内容。"
          }
        }
      }
    },
    "Hermes restarts once it's updated, and Bots pause for a minute.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新完成后 Hermes 会重启，智能体将暂停约一分钟。"
          }
        }
      }
    },
    "Hermes restarts when it's done, once running chats and tasks finish.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前对话和任务结束后，Hermes 将完成操作并重启。"
          }
        }
      }
    },
    "Hermes runs 1 card at a time on %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在 %@ 上每次处理 1 张卡片。"
          }
        }
      }
    },
    "Hermes runs at background priority": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 以后台优先级运行"
          }
        }
      }
    },
    "Hermes runs at full priority on %@, so it keeps answering when the Mac is busy.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在 %@ 上以最高优先级运行，因此 Mac 繁忙时仍能回复。"
          }
        }
      }
    },
    "Hermes runs commands in %@, where it takes no checkpoints.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在 %@ 中执行命令，那里不会创建检查点。"
          }
        }
      }
    },
    "Hermes runs on a computer you own: your Mac, a home server or a VPS. This app is how you talk to it from anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 运行在你自己的电脑、家庭服务器或 VPS 上。本应用让你随时随地与其交流。"
          }
        }
      }
    },
    "Hermes runs this chat's commands in %@, where it takes no checkpoints. To use undo here, run them on %@ itself (terminal.backend: local).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在 %@ 中执行此对话的命令，在该环境下不会建立检查点。要使用撤销功能，请直接在 %@ 上运行命令（terminal.backend: local）。"
          }
        }
      }
    },
    "Hermes runs up to %lld cards at once on %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在 %@ 上最多同时处理 %lld 张卡片。"
          }
        }
      }
    },
    "Hermes said: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 说：%@"
          }
        }
      }
    },
    "Hermes saves the folder before each turn that edits files.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在每轮编辑文件前都会保存文件夹。"
          }
        }
      }
    },
    "Hermes saves the folder before each turn that edits files. The last 20 are kept for 7 days; files over 10 MB aren't saved.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在每轮编辑文件前保存文件夹快照。最近的 20 份快照保留 7 天，超过 10 MB 的文件不会备份。"
          }
        }
      }
    },
    "Hermes saves the folder before the next turn that edits files.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 会在下一轮编辑文件前保存文件夹。"
          }
        }
      }
    },
    "Hermes saves what's worth keeping as you chat: how you like things done, your setup, your projects. Or just tell it: “Remember that…”": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 会在聊天时保存值得记住的内容，例如你的做事偏好、设备设置和项目。你也可以直接告诉它：“记住……”"
          }
        }
      }
    },
    "Hermes sees your edit next turn": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将在下一轮看到你的编辑"
          }
        }
      }
    },
    "Hermes sends lists, numbers and choices as text.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 会以文本形式发送列表、数字和选项。"
          }
        }
      }
    },
    "Hermes sends the new version back for your OK.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 会将新版本交给你确认。"
          }
        }
      }
    },
    "Hermes sent part of this change. Open the file to see all of it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 只发送了部分变更，打开文件可查看全部。"
          }
        }
      }
    },
    "Hermes still asks before anything that writes, as set in Chat Permissions.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于写入操作，Hermes 仍会按“对话权限”的设置事先征求确认。"
          }
        }
      }
    },
    "Hermes still learns skills; nothing merges or archives them.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 仍会学习技能，但不会合并或归档这些技能。"
          }
        }
      }
    },
    "Hermes still runs at background priority": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 仍以后台优先级运行"
          }
        }
      }
    },
    "Hermes still says %@ isn't available.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 仍提示 %@ 不可用。"
          }
        }
      }
    },
    "Hermes stopped waiting before your answer got there · %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 在收到你的回答前就停止等待 · %@"
          }
        }
      }
    },
    "Hermes stopped waiting · no answer in time": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 已停止等待 · 未及时收到回答"
          }
        }
      }
    },
    "Hermes stops using it. You can restore it from Tidying.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将停止使用此项，可从“整理”中恢复。"
          }
        }
      }
    },
    "Hermes stops using this %@ account.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 将停止使用此 %@ 账户。"
          }
        }
      }
    },
    "Hermes tells you when it's done.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 完成后会通知你。"
          }
        }
      }
    },
    "Hermes tidied its skills": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 已整理技能"
          }
        }
      }
    },
    "Hermes tidies what it learned by itself.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 会自行整理学到的内容。"
          }
        }
      }
    },
    "Hermes understands “in 30m”, “every 2h”, “every day at 09:00”, “every weekday at 08:00” and cron expressions such as “0 9 * * 1”.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 能理解“30 分钟后”“每 2 小时”“每天 09:00”“每个工作日 08:00”，也支持 0 9 * * 1 这样的 Cron 表达式。"
          }
        }
      }
    },
    "Hermes updates itself, then restarts once running chats and tasks finish. The app reconnects by itself.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 会自行更新，待正在运行的对话和任务完成后重启；本应用会自动重新连接。"
          }
        }
      }
    },
    "Hermes uses it again with your next message here.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在此发送下一条消息时，Hermes 将再次使用此项。"
          }
        }
      }
    },
    "Hermes uses one account at a time; say “use my %@ %@” in a chat, or pick it here.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 每次使用一个账户；可在对话中说“使用我的 %@ %@”，或在此选择。"
          }
        }
      }
    },
    "Hermes uses the %@ account you signed in to last. Sign in to this one again in the browser and Hermes switches to it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hermes 使用你上次登录的 %@ 账户。请在浏览器中重新登录此账户，Hermes 即会切换过来。"
          }
        }
      }
    },
    "Hermes uses this app's browser for a chat when Browser is set to In this app, while the app is open.": {
